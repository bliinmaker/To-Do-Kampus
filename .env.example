# Database
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo?schema=public

# JWT
JWT_SECRET=replace-with-a-strong-random-string
JWT_EXPIRES_IN=1d

# Server
PORT=3000

# Archive: days before permanently deleting archived tasks
ARCHIVE_RETENTION_DAYS=7
REDIS_HOST=localhost
REDIS_PORT=6379

# Telegram bot (optional, leave empty to disable)
TELEGRAM_BOT_TOKEN=

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
